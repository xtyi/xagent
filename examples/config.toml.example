# xagent configuration -- copy to ~/.xagent/config.toml
#
# This file is documentation: it shows the shape of the user-level config that
# `xagent/config.py` reads. To set one up:
#
#     mkdir -p ~/.xagent
#     cp examples/config.toml.example ~/.xagent/config.toml
#     # then fill in api_key
#
# `~/.xagent/` sits next to `~/.codex/`, and like `~/.codex/config.toml` it is
# user-level: one per machine, not per checkout. It lives outside the repo, so
# a key in it can never be committed.
#
# The shape is modeled on Codex's `~/.codex/config.toml` so a provider block
# can be copied over almost as-is. One deliberate rename:
#     experimental_bearer_token  ->  api_key
# (`experimental_` is Codex telling you the key may be renamed again; ours is
# ours to name.)
#
# Resolution order per setting, first hit wins:
#     CLI flag  >  environment variable  >  this file  >  built-in default

model_provider = "deepseek"
model = "deepseek-flash"
# Thinking effort. `none` disables thinking; other levels pick an intensity.
# Omit the line to leave it to the model's own default. Measured in probes/001.
reasoning_effort = "high"
temperature = 0.0
max_tokens = 2048
timeout = 120.0

[model_providers.deepseek]
name = "deepseek"
base_url = "https://api.deepseek.com/v1"
api_key = "sk-REPLACE-ME"

# To add another provider, add a block and point `model_provider` at it:
#
# [model_providers.openai]
# name = "openai"
# base_url = "https://api.openai.com/v1"
# api_key = "sk-..."
